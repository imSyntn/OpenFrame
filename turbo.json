{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env*"],
  "globalEnv": [
    "NODE_ENV",
    "AWS_REGION",
    "AWS_ENDPOINT_URL_S3",
    "FRONTEND_URL",
    "BACKEND_URL",
    "INTERNAL_SECRET",
    "ALLOWED_ORIGINS",
    "JWT_ACCESS_SECRET",
    "JWT_VERIFICATION_SECRET",
    "JWT_REFRESH_SECRET",
    "IMAGE_GEN_URL",
    "IMAGE_GEN_API_KEY",
    "REDIS_OTP_DB_URL",
    "ADMIN_EMAIL",
    "PORT",
    "AWS_BUCKET_NAME",
    "CDN_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "PATH",
    "SMTP_HOST",
    "SMTP_USER",
    "SMTP_PASS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    }
  }
}
